{
    "name": "src-rx",
    "private": true,
    "homepage": ".",
    "type": "module",
    "scripts": {
        "clean": "rimraf build",
        "start": "vite --port 3000",
        "lint": "eslint -c eslint.config.mjs src",
        "build": "vite build",
        "preview": "vite preview --port 3000",
        "check-ts": "tsc --noEmit --checkJS false",
        "tsc": "tsc --project tsconfig.json",
        "prettier": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,scss,md,html}",
        "npm": "npm i -f",
        "update-packages": "npx -y npm-check-updates --upgrade"
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not op_mini all"
    ],
    "dependencies": {
        "@iobroker/gui-components": "^10.0.15",
        "@iobroker/dm-gui-components": "^10.0.18",
        "@iobroker/json-config": "^9.0.18",
        "ace-builds": "^1.44.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@devbookhq/splitter": "^1.4.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/dm-utils": "^3.2.0",
        "@iobroker/socket-client": "^5.2.1",
        "@module-federation/runtime": "^2.8.2",
        "@module-federation/vite": "^1.20.4",
        "@originjs/vite-plugin-commonjs": "^1.0.3",
        "@react-leaflet/core": "^3.0.0",
        "@tsconfig/node20": "^20.1.9",
        "@types/ace": "^0.0.52",
        "@types/crypto-js": "^4.2.2",
        "@types/leaflet": "^1.9.22",
        "@types/less": "^3.0.8",
        "@types/lodash": "^4.17.25",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.1.2",
        "@types/react": "^19.2.18",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "buffer": "^6.0.3",
        "cron-parser": "^5.7.0",
        "crypto-js": "^4.2.0",
        "date-fns": "^4.4.0",
        "echarts": "^6.1.0",
        "echarts-for-react": "^3.0.6",
        "ipaddr.js": "^2.5.0",
        "json5": "^2.2.3",
        "leaflet": "^1.9.4",
        "leaflet-geosearch": "^4.4.0",
        "less": "^4.8.1",
        "lodash": "^4.18.1",
        "moment": "^2.30.1",
        "monaco-editor": "^0.56.0",
        "react": "^19.2.8",
        "react-ace": "^15.0.0",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dnd-multi-backend": "^9.0.0",
        "react-dnd-preview": "^9.0.0",
        "react-dnd-touch-backend": "^16.0.1",
        "react-dropzone": "^20.0.0",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "react-leaflet": "^5.0.0",
        "react-markdown": "^10.1.0",
        "react-monaco-editor": "^0.59.0",
        "react-qr-code": "^2.2.0",
        "react-showdown": "^2.3.1",
        "semver": "^7.8.5",
