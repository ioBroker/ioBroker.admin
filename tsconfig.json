{
    "compilerOptions": {
        // TypeScript 6 turns `strict` on by default. This project was never written against it,
        // so it stays off explicitly until the backend is migrated.
        "strict": false,
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "node16",
        "allowSyntheticDefaultImports": true,
        "checkJs": false,
        "noEmit": false,
        "outDir": "./build",
        "rootDir": "./src",
        "sourceMap": true,
        "sourceRoot": "./src",
        "noImplicitAny": true,
        "skipLibCheck": true,
        "lib": ["es2018", "DOM"],
        "jsx": "react",
        "types": ["@iobroker/types", "node"],
        "paths": {
            "@/*": ["./src/*"],
        }
    },
    "exclude": ["**/node_modules", "**/build", "adminWww/**"],
    "include": ["**/*.js", "**/*.ts", "**/*.d.ts",
        "eslint.config.mjs"
    ],
}
